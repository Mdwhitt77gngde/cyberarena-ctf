# Enforce LF line endings in the repository for all text files.
# This prevents CRLF/LF conflicts between Windows and Mac/Linux teammates.
* text=auto eol=lf

# Explicitly mark common text file types
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.env   text eol=lf

# Binary files — never touch line endings
*.db     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.woff2  binary
